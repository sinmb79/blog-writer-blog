# Blogger publishing
BLOG_MAIN_ID=
BLOG_SITE_URL=

# Google OAuth client used when creating token.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Writing providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# WordPress Application Password auth (optional)
WP_URL=https://your-site.com
WP_USERNAME=your_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Naver Blog automated publishing (optional)
NAVER_BLOG_ENABLED=false
NAVER_BLOG_URL=https://blog.naver.com/your_blog_id
NAVER_BLOG_NEW_POST_URL=https://blog.naver.com/PostWriteForm.naver
NAVER_CHROME_PROFILE_DIR=C:/Users/your-user/key/naver-blog-chrome-profile
NAVER_PUBLISH_RETRY_COUNT=3

# BananaPro image generation (optional)
BANANAPRO_API_URL=
BANANAPRO_API_KEY=
BANANAPRO_MODEL=banana-pro-image

# OpenAI image fallback for unattended Naver publishing (optional)
OPENAI_API_KEY=

# Optional OpenClaw local CLI
# openclaw should be available on PATH
